# Environment Configuration
# Copy this file to .env and adjust variables as required

APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production

# Password Hashing ('bcrypt' or 'argon2')
HASH_ALGORITHM=bcrypt
BCRYPT_ROUNDS=12

# Session Configuration
SESSION_COOKIE_NAME=secure_session_id
SESSION_EXPIRE_HOURS=24
REMEMBER_ME_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Security Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_LOCKOUT_TIME=900
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=600

# Database
DATABASE_PATH=./data/secure_auth.db
